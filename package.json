{
  "name": "quanzhi-kaoyan-desktop",
  "productName": "全职高手考研系统",
  "version": "1.0.1",
  "description": "全职高手考研系统桌面版 —— 基于网页版完整改造的本地化应用，数据与功能完全一致，离线可用",
  "main": "electron/main.js",
  "author": "quanzhi",
  "homepage": "https://github.com/william001207/quanzhi-kaoyan-desktop",
  "repository": {
    "type": "git",
    "url": "https://github.com/william001207/quanzhi-kaoyan-desktop.git"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "verify": "python3 scripts/verify_repo.py",
    "build:server": "npm --prefix server run build",
    "build:mac": "npm run build:server && electron-builder --mac --config build/electron-builder.yml",
    "build:win": "npm run build:server && electron-builder --win --config build/electron-builder.yml",
    "build:linux": "npm run build:server && electron-builder --linux --config build/electron-builder.yml",
    "build": "bash scripts/build-desktop.sh",
    "pack:linux": "electron-builder --linux --config build/electron-builder.yml",
    "pack:win": "electron-builder --win --config build/electron-builder.yml",
    "pack:mac": "electron-builder --mac --config build/electron-builder.yml"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  }
}
